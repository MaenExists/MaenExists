# MaenExists /write Studio Authentication & Configuration
# Configure these in your local .env and in Cloudflare Pages dashboard (Settings > Environment Variables)

# 1. Admin Credentials
# The secret username and password for /write
ADMIN_USERNAME=maen
ADMIN_PASSWORD=change-me-to-a-very-strong-secret-password

# Optional: You can provide a SHA-256 hash instead of a plain password
# ADMIN_PASSWORD_HASH=...

# 2. Session Secret (Required in production)
# A strong random secret used to sign session cookies
AUTH_SECRET=generate-a-random-32-character-secret-key-here

# 3. GitHub Integration (Required for publishing from browser on Cloudflare Pages)
# Create a Personal Access Token (classic or fine-grained) with 'repo' contents write access
# at https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_REPO=MaenExists/MaenExists
GITHUB_BRANCH=main
